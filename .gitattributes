# Keep portable shell scripts LF, and preserve Windows installer bytes even
# in Git archives. The bootstrap validator requires ASCII + CRLF for these.
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.bat -text
*.ps1 -text
# The AppImage entry point has no extension but must stay LF.
packaging/linux/AppRun text eol=lf
packaging/linux/*.desktop text eol=lf
